# EmailJS — enquiry form (browser / Vite)
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# EmailJS — OTP (server /api/send-otp). Falls back to VITE_EMAILJS_* for service + public key.
EMAILJS_OTP_TEMPLATE_ID=
# Optional server aliases / private key for EmailJS REST:
# EMAILJS_SERVICE_ID=
# EMAILJS_PUBLIC_KEY=
# EMAILJS_PRIVATE_KEY=   # required if Account → Security uses API strict mode

# Upstash Redis (OTP storage) — never use VITE_ prefix
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# HMAC secret for hashing OTPs — long random string, never use VITE_ prefix
OTP_SECRET=
